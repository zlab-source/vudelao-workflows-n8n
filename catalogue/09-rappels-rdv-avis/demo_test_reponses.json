    {
      "id": "00000000-0000-4000-8009-000000000024",
      "name": "Vérifier le lien",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        900
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function sha1(bytes) {\n  const ml = bytes.length * 8, avecUn = bytes.length + 1, len = avecUn + ((56 - (avecUn % 64)) + 64) % 64 + 8;\n  const m = new Uint8Array(len); m.set(bytes); m[bytes.length] = 0x80;\n  const dv = new DataView(m.buffer); dv.setUint32(len - 4, ml >>> 0); dv.setUint32(len - 8, Math.floor(ml / 2 ** 32));\n  let h0 = 0x67452301, h1 = 0xEFCDAB89, h2 = 0x98BADCFE, h3 = 0x10325476, h4 = 0xC3D2E1F0; const w = new Uint32Array(80);\n  for (let i = 0; i < len; i += 64) {\n    for (let t = 0; t < 16; t++) w[t] = dv.getUint32(i + t * 4);\n    for (let t = 16; t < 80; t++) { const x = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]; w[t] = (x << 1) | (x >>> 31); }\n    let a = h0, b = h1, c = h2, d = h3, e = h4;\n    for (let t = 0; t < 80; t++) {\n      const [f, k] = t < 20 ? [(b & c) | (~b & d), 0x5A827999] : t < 40 ? [b ^ c ^ d, 0x6ED9EBA1] : t < 60 ? [(b & c) | (b & d) | (c & d), 0x8F1BBCDC] : [b ^ c ^ d, 0xCA62C1D6];\n      const tmp = (((a << 5) | (a >>> 27)) + f + e + k + w[t]) >>> 0; e = d; d = c; c = ((b << 30) | (b >>> 2)) >>> 0; b = a; a = tmp;\n    }\n    h0 = (h0 + a) >>> 0; h1 = (h1 + b) >>> 0; h2 = (h2 + c) >>> 0; h3 = (h3 + d) >>> 0; h4 = (h4 + e) >>> 0;\n  }\n  return [h0, h1, h2, h3, h4].map(x => x.toString(16).padStart(8, '0')).join('');\n}\n// Jeton des liens envoyés au client : sans la clé secrète, impossible de fabriquer un lien valide.\nconst jeton = (ref, action, cle) => sha1(new Uint8Array(Buffer.from(ref + '|' + action + '|' + cle, 'utf8'))).slice(0, 20);\nconst lien = (reg, ref, action, extra = '') => reg.url_n8n + '/webhook/rdv-chene-et-cie?ref=' + encodeURIComponent(ref) + '&action=' + action + extra + '&jeton=' + jeton(ref, action, reg.cle_liens);\n// Lien cliqué par un client : on vérifie le jeton avant tout.\nconst q = $('Lien cliqué par le client').first().json.query ?? {};\nconst reg = $('Réglages').first().json;\nconst action = String(q.action ?? ''), ref = String(q.ref ?? '');\nconst valide = ['confirmer', 'deplacer', 'note'].includes(action) && ref && q.jeton === jeton(ref, action, reg.cle_liens);\nconst note = Math.max(1, Math.min(5, parseInt(q.valeur ?? '0', 10) || 0));\nreturn [{ json: { valide, action, ref, note: action === 'note' ? note : null, commentaire: String(q.commentaire ?? '').trim().slice(0, 2000),\n  jeton: q.jeton, lien_commentaire: valide && action === 'note' ? lien(reg, ref, 'note', '&valeur=' + note) : null, lien_avis_google: reg.lien_avis_google } }];"
      }
    },
