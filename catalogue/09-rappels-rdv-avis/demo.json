    {
      "id": "00000000-0000-4000-8009-000000000008",
      "name": "Joindre le fichier agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// L'écriture dans l'agenda ne transmet pas la pièce jointe : on la reprend ici.\nconst p = $('Préparer le rendez-vous').first();\nreturn [{ json: p.json, binary: { agenda: p.binary.agenda } }];"
