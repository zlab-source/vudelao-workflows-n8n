      "id": "00000000-0000-4000-8009-000000000006",
      "name": "Préparer le rendez-vous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function sha1(bytes) {\n  const ml = bytes.length * 8, avecUn = bytes.length + 1, len = avecUn + ((56 - (avecUn % 64)) + 64) % 64 + 8;\n  const m = new Uint8Array(len); m.set(bytes); m[bytes.length] = 0x80;\n  const dv = new DataView(m.buffer); dv.setUint32(len - 4, ml >>> 0); dv.setUint32(len - 8, Math.floor(ml / 2 ** 32));\n  let h0 = 0x67452301, h1 = 0xEFCDAB89, h2 = 0x98BADCFE, h3 = 0x10325476, h4 = 0xC3D2E1F0; const w = new Uint32Array(80);\n  for (let i = 0; i < len; i += 64) {\n    for (let t = 0; t < 16; t++) w[t] = dv.getUint32(i + t * 4);\n    for (let t = 16; t < 80; t++) { const x = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]; w[t] = (x << 1) | (x >>> 31); }\n    let a = h0, b = h1, c = h2, d = h3, e = h4;\n    for (let t = 0; t < 80; t++) {\n      const [f, k] = t < 20 ? [(b & c) | (~b & d), 0x5A827999] : t < 40 ? [b ^ c ^ d, 0x6ED9EBA1] : t < 60 ? [(b & c) | (b & d) | (c & d), 0x8F1BBCDC] : [b ^ c ^ d, 0xCA62C1D6];\n      const tmp = (((a << 5) | (a >>> 27)) + f + e + k + w[t]) >>> 0; e = d; d = c; c = ((b << 30) | (b >>> 2)) >>> 0; b = a; a = tmp;\n    }\n    h0 = (h0 + a) >>> 0; h1 = (h1 + b) >>> 0; h2 = (h2 + c) >>> 0; h3 = (h3 + d) >>> 0; h4 = (h4 + e) >>> 0;\n  }\n  return [h0, h1, h2, h3, h4].map(x => x.toString(16).padStart(8, '0')).join('');\n}\n// Jeton des liens envoyés au client : sans la clé secrète, impossible de fabriquer un lien valide.\nconst jeton = (ref, action, cle) => sha1(new Uint8Array(Buffer.from(ref + '|' + action + '|' + cle, 'utf8'))).slice(0, 20);\nconst lien = (reg, ref, action, extra = '') => reg.url_n8n + '/webhook/rdv-chene-et-cie?ref=' + encodeURIComponent(ref) + '&action=' + action + extra + '&jeton=' + jeton(ref, action, reg.cle_liens);\n// Rendez-vous saisi par l'atelier : référence, horaires (heure de Paris), fichier agenda pour le client.\nconst f = $('Nouveau rendez-vous').first().json;\nconst reg = $('Réglages').first().json;\nconst debut = DateTime.fromISO(f.date + 'T' + f.heure, { zone: 'Europe/Paris' });\nif (!debut.isValid) throw new Error('Date ou heure invalide : ' + f.date + ' ' + f.heure);\nconst DUREES = { '1 h': 60, '2 h': 120, '4 h': 240, 'Journée (8 h)': 480 };\nconst fin = debut.plus({ minutes: DUREES[f.duree] ?? 60 });\nconst reference = 'RDV-' + debut.toFormat('yyyyLLdd-HHmm') + '-' + String(f.client).normalize('NFD').replace(/[^A-Za-z]/g, '').slice(0, 6).toUpperCase();\nconst utc = d => d.toUTC().toFormat(\"yyyyMMdd'T'HHmmss'Z'\");\nconst ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//VudeLao//Rendez-vous//FR', 'BEGIN:VEVENT', 'UID:' + reference + '@chene-et-cie.demo', 'DTSTAMP:' + utc($now),\n  'DTSTART:' + utc(debut), 'DTEND:' + utc(fin), 'SUMMARY:' + f.type + ' · ' + reg.entreprise, 'LOCATION:' + String(f.adresse).replace(/[,;]/g, m => '\\\\' + m),\n  'BEGIN:VALARM', 'TRIGGER:-PT2H', 'ACTION:DISPLAY', 'DESCRIPTION:Rendez-vous ' + reg.entreprise, 'END:VALARM', 'END:VEVENT', 'END:VCALENDAR'].join('\\r\\n');\nreturn [{ json: { reference, client: f.client, email: String(f.email).trim().toLowerCase(), type: f.type, adresse: f.adresse,\n  debut: debut.toISO(), fin: fin.toISO(), quand: debut.setLocale('fr').toFormat(\"cccc d LLLL 'à' HH'h'mm\"), statut: 'planifié' },\n  binary: { agenda: await this.helpers.prepareBinaryData(Buffer.from(ics, 'utf8'), 'rendez-vous-' + reference + '.ics', 'text/calendar') } }];"
      }
    },
