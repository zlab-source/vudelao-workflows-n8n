      ],
      "parameters": {
        "sessionIdType": "fromInput",
        "contextWindowLength": 8
      }
    },
    {
      "name": "Base documentaire",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        520,
        1060
      ],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "documents_entreprise : recherche dans les documents de Chêne & Cie (CGV, garanties, délais, tarifs, entretien). Utilise-la pour toute question.",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "demo_chene_et_cie"
        },
        "topK": 5,
        "includeDocumentMetadata": true,
        "options": {}
      },
      "credentials": {
        "qdrantApi": {
          "name": "Qdrant local"
        }
      }
    },
    {
      "name": "Embeddings (nomic, local) ",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        560,
