    {
      "name": "Qui relancer aujourd'hui ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sélectionne les factures en retard et le niveau de relance à envoyer.\n// J+1 : rappel courtois · J+15 : relance ferme · J+30 : dernier rappel avant procédure.\n// Les niveaux s'enchaînent toujours dans l'ordre, avec au moins 7 jours entre deux relances.\nconst seuils = { 1: 1, 2: 15, 3: 30 };\nconst JOUR = 86400000, ECART_MIN = 7;\nconst today = new Date();\nconst out = [];\nfor (const { json: f } of $input.all()) {\n  const deja = Number(f.relances || 0);\n  const niveau = deja + 1;\n  if (niveau > 3) continue;\n  const retard = Math.floor((today - new Date(f.echeance)) / JOUR);\n  const depuisDerniere = f.derniere_relance ? Math.floor((today - new Date(f.derniere_relance)) / JOUR) : Infinity;\n  if (retard >= seuils[niveau] && depuisDerniere >= ECART_MIN) out.push({ json: { ...f, retard, niveau, deja } });\n}\nreturn out;"
      }
    },
