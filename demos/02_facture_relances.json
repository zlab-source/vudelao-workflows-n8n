    {
      "name": "Calculer la facture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Calcule la facture à partir du devis accepté.\nconst f = $json;\nconst ht = Math.round(Number(f.montant_ht) * 100) / 100;\nconst taux = Number(String(f.tva).replace(',', '.').replace('%', ''));\nconst tva = Math.round(ht * taux) / 100;\nconst ttc = Math.round((ht + tva) * 100) / 100;\nconst date = f.date_facture ? new Date(f.date_facture) : new Date();\nconst echeance = new Date(date); echeance.setDate(echeance.getDate() + Number(f.delai_jours || 30));\nconst numero = 'FAC-' + date.getFullYear() + '-' + String(Date.now()).slice(-5);\nreturn {\n  numero, client: f.client, email: f.email, prestation: f.prestation,\n  montant_ht: ht, taux_tva: taux, montant_tva: tva, montant_ttc: ttc,\n  date_facture: date.toISOString(), echeance: echeance.toISOString(),\n  statut: 'en_attente', relances: 0,\n};"
      }
    },
