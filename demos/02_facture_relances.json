      "parameters": {
        "fromEmail": "facturation@chene-et-cie.demo",
        "toEmail": "={{ $('Calculer la facture').item.json.email }}",
        "subject": "=Votre facture {{ $('Calculer la facture').item.json.numero }} · Chêne & Cie",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:640px;color:#23303B\">\n<h2 style=\"color:#4A5B6B;margin-bottom:0\">Chêne & Cie</h2><p style=\"margin-top:2px;color:#777\">Menuiserie · entreprise fictive de démonstration</p>\n<h3>Facture {{ $('Calculer la facture').item.json.numero }}</h3>\n<p>Bonjour {{ $('Calculer la facture').item.json.client }},<br>Merci pour votre confiance. Voici la facture correspondant au devis que vous avez accepté.</p>\n<table style=\"border-collapse:collapse;width:100%\">\n<tr><td style=\"padding:6px;border-bottom:1px solid #ddd\">{{ $('Calculer la facture').item.json.prestation }}</td><td style=\"padding:6px;border-bottom:1px solid #ddd;text-align:right\">{{ $('Calculer la facture').item.json.montant_ht.toFixed(2) }} € HT</td></tr>\n<tr><td style=\"padding:6px\">TVA {{ $('Calculer la facture').item.json.taux_tva }} %</td><td style=\"padding:6px;text-align:right\">{{ $('Calculer la facture').item.json.montant_tva.toFixed(2) }} €</td></tr>\n<tr><td style=\"padding:6px\"><b>Total TTC</b></td><td style=\"padding:6px;text-align:right\"><b>{{ $('Calculer la facture').item.json.montant_ttc.toFixed(2) }} €</b></td></tr>\n</table>\n<p>Échéance : <b>{{ DateTime.fromISO($('Calculer la facture').item.json.echeance).setLocale('fr').toLocaleString(DateTime.DATE_FULL) }}</b>.</p>\n<p>Bien cordialement,<br>L'équipe Chêne & Cie</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
