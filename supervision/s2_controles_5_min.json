    {
      "name": "Rédiger l'alerte disponibilité",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const esc = s => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\nconst carte = (couleur, titre, lignes) => `<div style=\"font-family:Arial,sans-serif;max-width:640px;border-left:5px solid ${couleur};padding:6px 16px\">\n<h2 style=\"margin:4px 0 10px;color:#23303B\">${titre}</h2>${lignes.filter(Boolean).map(([k, v]) => `<p style=\"margin:4px 0\"><b>${k} :</b> ${v}</p>`).join('')}\n<p style=\"color:#8FA3B5;font-size:12px;margin-top:14px\">Supervision n8n · ${new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris' })}</p></div>`;\nconst i = $('Préparer l\\'incident').item.json;\nconst bas = i.type === 'indisponible';\nreturn { sujet: (bas ? '🔴 Instance hors ligne · ' : '🟢 Instance rétablie · ') + i.client, html: carte(bas ? '#E5484D' : '#30A46C',\n  bas ? 'Instance n8n injoignable' : 'Instance n8n rétablie', [\n  ['Client', esc(i.client)], ['Adresse contrôlée', esc(i.noeud)], ['Détail', esc(i.message)],\n  !bas && ['Durée de l\\'interruption', i.duree_min + ' min (précision : 5 min)'] ]) };"
      }
    },
