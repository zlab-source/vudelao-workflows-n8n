            "echecs": "={{ $json.echecs }}",
            "derniere_verif": "={{ $json.verif }}",
            "hors_ligne_depuis": "={{ $json.evenement === 'indisponible' ? $json.verif : ($json.etat === 'ok' ? null : $('Instances à vérifier').item.json.hors_ligne_depuis) }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "etat",
              "displayName": "etat",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "echecs",
