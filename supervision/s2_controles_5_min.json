    {
      "name": "Tâches en retard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Une tâche est en retard si aucun signal de vie n'est arrivé depuis 1,5 × sa fréquence attendue.\nconst out = [];\n$input.all().forEach((i, n) => {\n  const t = i.json;\n  if (t.actif === false || t.en_retard === true) return;\n  // Jamais moins de 10 min : le contrôle lui-même ne passe que toutes les 5 min.\n  const attendu = Math.max(Number(t.frequence_min || 1440) * 1.5, 10) * 60000;\n  const dernier = t.dernier_signal ? new Date(t.dernier_signal).getTime() : 0;\n  if (Date.now() - dernier > attendu) out.push({ json: { ...t, depuis_min: dernier ? Math.round((Date.now() - dernier) / 60000) : null }, pairedItem: { item: n } });\n});\nreturn out;"
      }
    },
