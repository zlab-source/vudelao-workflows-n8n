              "type": "dateTime",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "hors_ligne_depuis",
              "displayName": "hors_ligne_depuis",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "dateTime",
