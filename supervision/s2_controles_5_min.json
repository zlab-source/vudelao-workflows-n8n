        "returnAll": true
      }
    },
    {
      "name": "Instances à vérifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Garde uniquement les instances actives.\nreturn $input.all().filter(i => i.json.actif !== false).map((i, n) => ({ json: i.json, pairedItem: { item: n } }));"
      }
    },
    {
      "name": "Tester l'instance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "name": "Évaluer l'état",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compare le résultat du contrôle à l'état précédent. Hors ligne après 2 échecs consécutifs (évite les fausses alertes).\nconst c = $('Instances à vérifier').item.json;\nconst ok = !$json.error && Number($json.statusCode) === 200;\nconst echecs = ok ? 0 : Number(c.echecs || 0) + 1;\nconst avant = c.etat || 'ok';\nconst apres = ok ? 'ok' : (echecs >= 2 ? 'hors_ligne' : avant);\nlet evenement = null;\nif (avant !== 'hors_ligne' && apres === 'hors_ligne') evenement = 'indisponible';\nif (avant === 'hors_ligne' && apres === 'ok') evenement = 'retablie';\nconst detail = ok ? 'HTTP 200' : ($json.error?.message || $json.error || ('HTTP ' + $json.statusCode));\nreturn { id: c.id, client: c.client, url: c.url, echecs, etat: apres, evenement, detail: String(detail).slice(0, 300), verif: new Date().toISOString() };"
      }
    },
    {
      "name": "Mettre à jour l'état",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
