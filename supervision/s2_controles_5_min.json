    {
      "name": "Préparer l'incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Journalise le changement d'état ; calcule la durée de l'interruption lors du rétablissement.\nconst e = $('Évaluer l\\'état').item.json;\nconst debut = $('Instances à vérifier').item.json.hors_ligne_depuis;\nconst duree = e.evenement === 'retablie' && debut ? Math.round((Date.now() - new Date(debut)) / 60000) : 0;\nreturn {\n  horodatage: e.verif, client: e.client, type: e.evenement, workflow: 'Instance n8n', noeud: e.url,\n  message: e.evenement === 'indisponible' ? 'Instance injoignable : ' + e.detail : 'Instance de nouveau disponible',\n  lien: e.url, cle: e.client + ' | disponibilite', alerte: true, duree_min: duree,\n};"
      }
    },
